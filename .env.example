# Railway environment variables for QuickCart
# Copy to Railway project variables

# ── App ──
NODE_ENV=production
PORT=3344

DATABASE_URL=postgres://user:pass@host:5432/quickcart
REDIS_URL=redis://host:6379

# ── WhatsApp (Meta Cloud API) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# ── STT/LLM (Groq, opcional) ──
GROQ_API_KEY=

# ── Nota fiscal (opcional) ──
FISCAL_ENABLED=false

# ── E-mail (opcional, para envio de recibos) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Tokens internos ──
ADMIN_API_TOKEN=
INTERNAL_API_TOKEN=
ALLOWED_ORIGINS=https://quickcart-web.up.railway.app

# ── Bull Board (worker) ──
BULL_BOARD_PORT=3010
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=

# ── Loja ──
STORE_NAME=QuickCart
STORE_CNPJ=
STORE_ADDRESS=

# ── Worker ──
API_BASE_URL=http://localhost:3344
