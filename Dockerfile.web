FROM oven/bun:1.3-alpine AS builder
WORKDIR /app

COPY package.json bun.lockb tsconfig.json ./
COPY apps/api-quickcart/package.json ./apps/api-quickcart/
COPY apps/worker-quickcart/package.json ./apps/worker-quickcart/
COPY apps/frontend-web/package.json ./apps/frontend-web/
RUN bun install --frozen-lockfile

COPY . .
WORKDIR /app/apps/frontend-web
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN bun run build

FROM nginx:alpine AS runner
COPY --from=builder /app/apps/frontend-web/dist /usr/share/nginx/html
# Template: o entrypoint do nginx faz envsubst de ${PORT} ao iniciar (Railway injeta PORT).
COPY apps/frontend-web/nginx.conf /etc/nginx/templates/default.conf.template

ENV PORT=80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
