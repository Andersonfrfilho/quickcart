FROM oven/bun:1.3-alpine AS deps
WORKDIR /app
COPY package.json bun.lockb tsconfig.json ./
COPY apps/api-quickcart/package.json ./apps/api-quickcart/
COPY apps/worker-quickcart/package.json ./apps/worker-quickcart/
COPY apps/frontend-web/package.json ./apps/frontend-web/
RUN bun install --frozen-lockfile

FROM oven/bun:1.3-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
# O bun NÃO iça as dependências para a raiz neste workspace: `/app/node_modules` guarda só o
# store (`.bun/`), e os links de cada pacote vivem em `apps/<app>/node_modules`. Copiar apenas a
# raiz deixava a imagem sem `tsc` (o typecheck abaixo morria com exit 127) e, pior, sem
# `drizzle-orm`, `bullmq` e `ioredis` em tempo de execução. Os links são relativos e apontam para
# `../../../node_modules/.bun/...`, que a linha anterior já trouxe.
COPY --from=deps /app/apps/worker-quickcart/node_modules ./apps/worker-quickcart/node_modules
COPY . .
RUN bun run --filter @quickcart/worker typecheck

FROM oven/bun:1.3-alpine AS runner
WORKDIR /app

RUN apk add --no-cache dumb-init

COPY --from=deps /app/node_modules ./node_modules
# `apps/worker-quickcart` vem inteiro do builder, com o `node_modules` dele junto.
COPY --from=builder /app/apps/worker-quickcart ./apps/worker-quickcart
COPY --from=builder /app/tsconfig.json ./tsconfig.json

ENV NODE_ENV=production

CMD ["dumb-init", "bun", "run", "apps/worker-quickcart/src/index.ts"]
