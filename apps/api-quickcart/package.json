{
  "name": "@quickcart/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "db:address-inventory": "bun run src/infra/database/inventoryAddresses.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/infra/database/migrate.ts",
    "db:migrate-notification": "bun run src/infra/database/migrateNotification.ts",
    "db:reseed-flow": "bun run src/infra/database/seeds/reseedMainFlow.ts",
    "db:seed": "bun run src/infra/database/seeds/index.ts",
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test --preload ./tests/setup.ts",
    "test:e2e": "bun test --env-file=../../envs/env.test.e2e ./tests/e2e/orderStatusNotification.e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adatechnology/audio-transcription-provider": "0.1.0-rc.1",
    "@adatechnology/meta-whatsapp-contracts": "0.2.0-rc.9",
    "@adatechnology/meta-whatsapp-module": "0.2.0-rc.17",
    "@adatechnology/meta-whatsapp-provider": "0.2.0-rc.3",
    "@adatechnology/module-http": "0.1.0-rc.1",
    "@adatechnology/notification-contracts": "0.1.0-rc.1",
    "@adatechnology/notification-module": "0.1.0-rc.1",
    "@adatechnology/object-storage-provider": "0.1.1",
    "@adatechnology/text-moderation": "0.2.0-rc.0",
    "bullmq": "^5.79.2",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.11.1",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.4",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.27.2",
    "typescript": "^5.7.3"
  }
}
