{
  "name": "@quickcart/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./tests/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/infra/database/migrate.ts",
    "db:seed": "bun run src/infra/database/seeds/index.ts"
  },
  "dependencies": {
    "@adatechnology/whatsapp-provider": "^0.2.3",
    "bullmq": "^5.79.2",
    "drizzle-orm": "^0.36.4",
    "ioredis": "5.11.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.27.2",
    "typescript": "^5.7.3"
  }
}
