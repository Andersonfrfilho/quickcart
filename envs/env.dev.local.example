# Copie para `envs/env.dev.local` (gitignored) e preencha com credenciais reais quando for
# testar contra a Graph API de verdade em vez do WireMock local.
#
# `envs/env.dev.local` NUNCA é commitado — sobrescreva manualmente as variáveis abaixo no seu
# `envs/env.dev` local, ou exporte-as no shell antes de `make dev-api`
# (ex: `set -a && source envs/env.dev.local && set +a`).

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BASE_URL=

GROQ_API_KEY=

SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

SENTRY_DSN=

# Sobrescreva com uma chave própria se for testar supressão localmente.
# NOTIFICATION_SUPPRESSION_KEY=
