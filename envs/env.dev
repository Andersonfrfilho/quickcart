PROJECT_NAME=quickcart
APP_ENV=dev

# ── App ──
PORT=3344
NODE_ENV=development
DATABASE_URL=postgres://quickcart:quickcart@localhost:5442/quickcart_dev
REDIS_URL=redis://localhost:6390

# ── WhatsApp (Meta Cloud API) — valores mock, wiremock responde localmente ──
WHATSAPP_ACCESS_TOKEN=dev-mock-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=http://localhost:9563

# ── STT/LLM (opcional) ──
GROQ_API_KEY=

# ── Nota fiscal (opcional) ──
FISCAL_ENABLED=false

# ── E-mail (opcional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Tokens internos ──
ADMIN_API_TOKEN=dev-admin-token-change-me
INTERNAL_API_TOKEN=dev-internal-token-change-me
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3344

# ── Observabilidade (opcional) ──
SENTRY_DSN=

# ── Infra local (docker-compose) ──
POSTGRES_DB=quickcart_dev
POSTGRES_USER=quickcart
POSTGRES_PASSWORD=quickcart
POSTGRES_PORT=5442
REDIS_PORT=6390
WIREMOCK_PORT=9563
