PROJECT_NAME=quickcart
APP_ENV=dev

# ── App ──
PORT=3344
NODE_ENV=development
DATABASE_URL=postgres://quickcart:quickcart@localhost:5442/quickcart_dev
REDIS_URL=redis://localhost:6390

# ── WhatsApp (Meta Cloud API) — valores mock, wiremock responde localmente ──
WHATSAPP_ACCESS_TOKEN=dev-mock-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret

# Deixa o simulador de cliente LER o transcript sem sessão de admin, autorizando por HMAC do app
# secret acima. Só local: staging e produção não definem esta variável, e sem ela a rota responde 404.
PREVIEW_TRANSCRIPT_ENABLED=true
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=http://localhost:9563

# ── STT/LLM (opcional) ──
GROQ_API_KEY=

# ── Moderação de conteúdo ──
# Marca mensagem ofensiva do cliente no transcript (não bloqueia, não censura).
MODERATION_ENABLED=false
# Termos além do núcleo pt-BR do pacote, separados por vírgula.
MODERATION_EXTRA_TERMS=
# Resgata falso positivo — ex.: termo que é nome de produto do catálogo.
MODERATION_ALLOWED_TERMS=

# ── Transcrição de nota de voz (persistida, exibida e copiável na inbox) ──
# Desligada até ter chave: ligada sem TRANSCRIPTION_GROQ_API_KEY, o adapter avisa no log e o módulo
# grava as colunas nulas ("não avaliado") em vez de fingir que tentou.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_MODE=onDemand
TRANSCRIPTION_GROQ_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_LOCAL_FALLBACK_ENABLED=false
TRANSCRIPTION_LOCAL_MODEL_PATH=/models/ggml-small.bin

# ── Nota fiscal (opcional) — @adatechnology/fiscal-provider (NFC-e) ──
# Deixe FISCAL_ENABLED=false em dev/test. Para habilitar em produção, preencha
# todas as variáveis abaixo (certificado A1 e CSC vêm do portal SEFAZ do estado
# do emitente — nunca reaproveitar certificado de outro CNPJ/cliente).
FISCAL_ENABLED=false
FISCAL_ENVIRONMENT=homologacao
FISCAL_CNPJ=
FISCAL_INSCRICAO_ESTADUAL=
FISCAL_RAZAO_SOCIAL=
FISCAL_UF=
FISCAL_MUNICIPIO=
FISCAL_CODIGO_MUNICIPIO=
FISCAL_CEP=
FISCAL_LOGRADOURO=
FISCAL_NUMERO_ENDERECO=
FISCAL_BAIRRO=
FISCAL_CRT=1
FISCAL_CERTIFICADO_BASE64=
FISCAL_CERTIFICADO_SENHA=
FISCAL_SERIE=1
FISCAL_CSC_ID=
FISCAL_CSC_TOKEN=
FISCAL_DEFAULT_NCM=22021000
FISCAL_DEFAULT_CFOP=5102
FISCAL_DEFAULT_CST=500

# ── E-mail (opcional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Tokens internos ──
ADMIN_API_TOKEN=dev-admin-token-change-me
INTERNAL_API_TOKEN=dev-internal-token-change-me
ALLOWED_ORIGINS=http://localhost:5183,http://localhost:3344,http://localhost:5189

# ── Observabilidade (opcional) ──
SENTRY_DSN=
LOG_LEVEL=debug

# ── Loja (recibo/nota — Fase 7) ──
STORE_NAME=QuickCart
STORE_CNPJ=
STORE_ADDRESS=Rua Exemplo, 123 - Centro

# Distância e previsão de chegada. STORE_CEP é o interruptor: sem ele, a tela mostra endereço sem distância.
# CEP real (Consolação, São Paulo) para a feature funcionar em dev de verdade, não com coordenada inventada.
STORE_CEP=01415-000
DISTANCE_DETOUR_FACTOR=1.35
DELIVERY_AVERAGE_SPEED_KMH=25
STORE_PREPARATION_MINUTES=20
STORE_DELIVERY_RADIUS_KM=8

# ── Worker (worker-quickcart) ──
API_BASE_URL=http://localhost:3344
BULL_BOARD_PORT=3346
BULL_BOARD_USER=dev-admin
BULL_BOARD_PASSWORD=dev-admin-change-me

# ── Infra local (docker-compose) ──
POSTGRES_DB=quickcart_dev
POSTGRES_USER=quickcart
POSTGRES_PASSWORD=quickcart
POSTGRES_PORT=5442
REDIS_PORT=6390
WIREMOCK_PORT=9563

# ── Object storage (arquivos da conversa) ──
# MinIO local; em staging/produção aponte para o bucket gerenciado (o provider fala S3).
STORAGE_ENABLED=true
STORAGE_ENDPOINT=http://localhost:9566
STORAGE_REGION=us-east-1
STORAGE_BUCKET=quickcart-documents
STORAGE_ACCESS_KEY_ID=quickcart
STORAGE_SECRET_ACCESS_KEY=quickcart123
# MinIO exige path-style; a maioria dos buckets gerenciados aceita virtual-host.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_OBJECT_SIZE_BYTES=26214400
# TTL da URL assinada que o atendente recebe ao abrir um anexo.
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
MINIO_PORT=9566
MINIO_CONSOLE_PORT=9567

# ── Retenção dos arquivos da conversa ──
# 0 desliga. Apagar por padrão destruiria dado de quem nunca pediu.
DOCUMENTS_RETENTION_DAYS=0
DOCUMENTS_RETENTION_SWEEP_HOURS=24
DOCUMENTS_RETENTION_BATCH_SIZE=200

# Teto do zip em lote (o binário passa pela memória da API).
DOCUMENTS_ARCHIVE_MAX_BYTES=20971520

# Chave do HMAC da lista de supressão de notificações. A lista guarda hash, nunca o endereço em
# claro. API e worker precisam da MESMA chave: hashes diferentes fariam um endereço suprimido voltar
# a receber. Em produção vem do gerenciador de segredos, nunca deste arquivo.
NOTIFICATION_SUPPRESSION_KEY=dev-suppression-key-trocar-em-producao-32c

# Caixa de entrada falsa (Mailpit). O canal de e-mail do notification-module aponta para cá em
# desenvolvimento: aceita qualquer credencial e não entrega nada para fora, então não há risco de
# mandar mensagem de teste para endereço real.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
NOTIFICATION_SMTP_URL=smtp://localhost:1025
NOTIFICATION_EMAIL_FROM=nao-responda@quickcart.local
