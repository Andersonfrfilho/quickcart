PROJECT_NAME=quickcart
APP_ENV=test

# ── App ──
PORT=3345
NODE_ENV=test
DATABASE_URL=postgres://quickcart:quickcart@localhost:5443/quickcart_test
REDIS_URL=redis://localhost:6391

# ── WhatsApp (Meta Cloud API) — valores mock, wiremock responde localmente ──
WHATSAPP_ACCESS_TOKEN=test-mock-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
WHATSAPP_WEBHOOK_VERIFY_TOKEN=test-verify-token
WHATSAPP_APP_SECRET=test-app-secret
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=http://localhost:9564

# ── STT/LLM (opcional) ──
GROQ_API_KEY=

# ── Nota fiscal (opcional) ──
FISCAL_ENABLED=false

# ── E-mail (opcional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Tokens internos ──
ADMIN_API_TOKEN=test-admin-token
INTERNAL_API_TOKEN=test-internal-token
ALLOWED_ORIGINS=http://localhost:5173

# ── Observabilidade (opcional) ──
SENTRY_DSN=
LOG_LEVEL=error

# ── Loja (recibo/nota — Fase 7) ──
STORE_NAME=QuickCart Test
STORE_CNPJ=
STORE_ADDRESS=Rua de Teste, 123

# STORE_CEP ausente de propósito: com ele, um teste de integração tentaria geocodificar de verdade e
# passaria a depender de rede (e do limite de 1 req/s do Nominatim). Sem ele, a estimativa não é calculada.

# ── Worker (worker-quickcart) ──
API_BASE_URL=http://localhost:3345
BULL_BOARD_PORT=3347
BULL_BOARD_USER=test-admin
BULL_BOARD_PASSWORD=test-admin

# ── Infra local (docker-compose) ──
POSTGRES_DB=quickcart_test
POSTGRES_USER=quickcart
POSTGRES_PASSWORD=quickcart
POSTGRES_PORT=5443
REDIS_PORT=6391
WIREMOCK_PORT=9564

# ── Object storage (isolado do dev: mesma convenção de porta +1 do postgres/redis) ──
MINIO_PORT=9568
MINIO_CONSOLE_PORT=9569
STORAGE_ENABLED=false
STORAGE_ENDPOINT=http://localhost:9568
STORAGE_BUCKET=quickcart-documents-test
STORAGE_ACCESS_KEY_ID=quickcart
STORAGE_SECRET_ACCESS_KEY=quickcart123
NOTIFICATION_SUPPRESSION_KEY=test-suppression-key-com-32-caracteres

# Sem NOTIFICATION_SMTP_URL: em teste o canal de e-mail simplesmente não é planejado.
NOTIFICATION_EMAIL_FROM=teste@quickcart.local
